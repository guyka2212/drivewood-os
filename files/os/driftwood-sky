#!/bin/bash
# driftwood-sky: match the Driftwood wallpaper to the real time of day.
#   dawn 05-08 · midday 08-17 · dusk 17-20 · night 20-05
# Runs from a timer. It only switches when the time of day moves into a new
# period, so a wallpaper you pick yourself stays until the next period.
# Only acts while the Driftwood theme is active. --force applies right now.
THEME_NAME=$(cat "$HOME/.local/state/omarchy/current/theme.name" 2>/dev/null)
[[ ${THEME_NAME,,} == drivewood ]] || exit 0

BG="$HOME/.local/state/omarchy/current/theme/backgrounds"
STATE="$HOME/.local/state/omarchy/driftwood-sky.last"
h=$((10#$(date +%H)))
if   (( h >= 5  && h < 8  )); then pick=1-dawn.png
elif (( h >= 8  && h < 17 )); then pick=2-noon.png
elif (( h >= 17 && h < 20 )); then pick=3-dusk.png
else                               pick=4-night.png
fi

if [[ $1 == --force || $(cat "$STATE" 2>/dev/null) != "$pick" ]]; then
  omarchy-theme-bg-set "$BG/$pick" && echo "$pick" > "$STATE" && echo "sky -> $pick"
else
  echo "still the same part of the day ($pick); leaving the wallpaper alone"
fi
